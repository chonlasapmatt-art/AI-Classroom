# Browser-safe values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
VITE_APP_BASE_URL=http://localhost:4173
VITE_SYNC_PROTOCOL_VERSION=1

# Server/Edge Function secrets — never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
PARENT_LINK_HMAC_SECRET=
ADMIN_ACCESS_CODE_HASH=
STUDENT_ACCESS_HMAC_SECRET=
MEMBER_ACCESS_HMAC_SECRET=
MEMBER_INVITATION_HMAC_SECRET=
# Signs and seals teacher access codes. Falls back to MEMBER_ACCESS_HMAC_SECRET when unset;
# changing it makes existing codes unreadable, and a school must rotate to get a working one.
TEACHER_CODE_SECRET=
# SHA-256 hex of the code that enrols the first platform operator. Store the hash, never the code.
PLATFORM_ADMIN_CODE_HASH=
# Seals every product activation key so the operator who sold the server can read one back. At least
# 32 characters. First-run refuses to draw a key while this is unset: a key nobody can ever recover
# is the failure the key exists to prevent. Rotating it makes keys sealed under the old value
# unreadable — they still activate, but nobody can be told what they are.
PRODUCT_KEY_SECRET=
# Presented by the scheduler as x-notification-dispatch-secret when it calls notification-dispatch.
NOTIFICATION_DISPATCH_SECRET=
# Development only. The one-field console sign-in is a separate Edge Function that a production
# project does not deploy; where it is deployed it stays inert unless this is exactly "true".
# PLATFORM_DEV_OPERATOR names which operator it signs in as when the platform has more than one.
PLATFORM_DEV_SIGN_IN=false
PLATFORM_DEV_OPERATOR=
ALLOWED_ORIGINS=http://localhost:4173

# Build target. Set to false for the customer build (web, PWA, Android): the operations console is
# then not built at all rather than merely hidden.
INCLUDE_PLATFORM_CONSOLE=true

# Development Preview Mode (dev builds only unless explicitly enabled)
VITE_PLATFORM_DEV_SIGN_IN=false
VITE_ENABLE_PREVIEW_MODE=false
