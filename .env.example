# Browser-safe values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
VITE_APP_BASE_URL=http://localhost:4173
VITE_SYNC_PROTOCOL_VERSION=1

# Server/Edge Function secrets — never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
PARENT_LINK_HMAC_SECRET=
ADMIN_ACCESS_CODE_HASH=
STUDENT_ACCESS_HMAC_SECRET=
MEMBER_ACCESS_HMAC_SECRET=
MEMBER_INVITATION_HMAC_SECRET=
# Signs and seals teacher access codes. Falls back to MEMBER_ACCESS_HMAC_SECRET when unset;
# changing it makes existing codes unreadable, and a school must rotate to get a working one.
TEACHER_CODE_SECRET=
# SHA-256 hex of the code that enrols the first platform operator. Store the hash, never the code.
PLATFORM_ADMIN_CODE_HASH=
ALLOWED_ORIGINS=http://localhost:4173

# Build target. Set to false for the customer build (web, PWA, Android): the operations console is
# then not built at all rather than merely hidden.
INCLUDE_PLATFORM_CONSOLE=true

# Development Preview Mode (dev builds only unless explicitly enabled)
VITE_ENABLE_PREVIEW_MODE=false
